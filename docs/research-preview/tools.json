    "cook": {
      "name": "cook",
      "description": "Cook portions of a dish in the kitchen of the Linde, from what the kitchen holds, a portion of each from its ingredients: vegetable soup (vegetable-soup) from 2 units of vegetables; an omelette (omelette) from 2 units of eggs and 1 unit of vegetables; a rice bowl (rice-bowl) from 2 units of rice and 1 unit of vegetables; pancakes (pancakes) from 1 unit of flour and 1 unit of eggs; fish pie (fish-pie) from 1 unit of fish and 1 unit of flour; stew (stew) from 1 unit of meat and 2 units of vegetables. The portions left at midnight are gone; what the kitchen holds to cook with keeps.",
      "parameters": {
        "type": "object",
        "properties": {
          "dish": {
            "type": "string",
            "enum": [
              "vegetable-soup",
              "omelette",
              "rice-bowl",
              "pancakes",
              "fish-pie",
              "stew"
            ],
            "description": "the dish's short name"
          },
          "portions": {
            "type": "integer",
            "description": "how many portions to cook",
            "minimum": 1
          }
        },
        "required": [
          "dish",
          "portions"
        ]
      }
    },
    "set_price": {
      "name": "set_price",
      "description": "Set the price of something you sell: what the Store sells, a dish on the menu of the Linde, or the fee for an examination or a treatment at the Hospital.",
      "parameters": {
        "type": "object",
        "properties": {
          "item": {
