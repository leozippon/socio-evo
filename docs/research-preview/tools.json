    "eat__Jonas": {
      "name": "eat",
      "description": "Eat a helping of food you keep, now. You also eat it by yourself whenever you could eat. At work in the kitchen, you can also eat a dish ready to serve; nobody pays.",
      "parameters": {
        "type": "object",
        "properties": {
          "item": {
            "type": "string",
            "enum": [
              "bread",
              "fruit",
              "vegetable-soup",
              "omelette",
              "rice-bowl",
              "pancakes",
              "fish-pie",
              "stew"
            ],
