{
  "declarations": {
    "read_file": {
      "name": "read_file",
      "description": "Read one of your files. For a long file, give offset and limit to read some of its lines.",
      "parameters": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "description": "The file, such as memory/notes.md."
          },
          "offset": {
            "type": "integer",
            "description": "The first line to read, from 1."
          },
          "limit": {
            "type": "integer",
            "description": "How many lines to read."
          }
        },
        "required": [
          "path"
        ]
      }
    },
    "write_file": {
      "name": "write_file",
      "description": "Write one of your files, replacing all it held, or create it with any folders it needs.",
      "parameters": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "description": "The file, such as skills/reading-a-traceback.md."
          },
          "content": {
            "type": "string",
            "description": "Everything the file is to hold."
          }
        },
        "required": [
          "path",
          "content"
        ]
      }
    },
    "edit_file": {
      "name": "edit_file",
      "description": "Replace a passage of one of your files with new text. The passage must appear exactly once in the file.",
      "parameters": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "description": "The file, such as memory/notes.md."
          },
          "old_text": {
            "type": "string",
            "description": "The passage as it stands."
          },
          "new_text": {
            "type": "string",
            "description": "What replaces it."
          }
        },
        "required": [
          "path",
          "old_text",
          "new_text"
        ]
      }
    },
    "list_files": {
      "name": "list_files",
      "description": "List your files, or those in one folder, such as skills.",
      "parameters": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "description": "A folder, such as memory; all your files if left out."
          }
        }
      }
    },
    "compact": {
      "name": "compact",
      "description": "Stop and write down for yourself what you will want to remember of all that has happened so far; you then keep those notes and the last few things that happened, and let the rest go.",
      "parameters": {
        "type": "object",
        "properties": {}
      }
    },
    "help": {
      "name": "help",
      "description": "Read more of how the town works, on one point; without one, what you can ask about: office, store, restaurant, hospital, hall, money, body, day, places and research.",
      "parameters": {
        "type": "object",
        "properties": {
          "topic": {
            "type": "string",
            "enum": [
              "office",
              "store",
              "restaurant",
              "hospital",
              "hall",
              "money",
              "body",
              "day",
              "places",
              "research"
            ]
          }
        },
        "required": []
      }
    },
    "look_around": {
      "name": "look_around",
      "description": "See where you are, who is here and what each of them is doing, what is for sale here and what is left here for anyone to take.",
      "parameters": {
        "type": "object",
        "properties": {},
        "required": []
      }
    },
    "how_am_i": {
      "name": "how_am_i",
      "description": "Take stock of how you feel: how hungry, how tired and how well you are.",
      "parameters": {
        "type": "object",
        "properties": {},
        "required": []
      }
    },
    "inventory": {
      "name": "inventory",
      "description": "See what you have: your money, and each thing you keep, with how much is left of it and any daily charge on it.",
      "parameters": {
        "type": "object",
        "properties": {},
        "required": []
      }
    },
    "go": {
      "name": "go",
      "description": "Walk to another place in town. You arrive after the walk; on the way you can do nothing and nobody can speak to you.",
      "parameters": {
        "type": "object",
        "properties": {
          "place": {
            "type": "string",
            "enum": [
              "mill-street-house",
              "college-flat",
              "market-flat",
              "river-cottage",
              "hill-road-house",
              "office",
              "store",
              "linde",
              "hospital",
              "town-hall",
              "river-walk"
            ],
            "description": "the place's short name, as given in brackets under Places"
          }
        },
        "required": [
          "place"
        ]
      }
    },
    "wait": {
      "name": "wait",
      "description": "Let time pass where you are. You are told when something happens, or when the minutes are up.",
      "parameters": {
        "type": "object",
        "properties": {
          "minutes": {
            "type": "integer",
            "description": "how many minutes to wait",
            "minimum": 1,
            "maximum": 600
          }
        },
        "required": [
          "minutes"
        ]
      }
    },
    "sleep": {
      "name": "sleep",
      "description": "Go to bed at home, at any hour, until the hour you give. You can then look back over your day and see to your files before you fall asleep.",
      "parameters": {
        "type": "object",
        "properties": {
          "until": {
            "type": "string",
            "description": "the hour to wake, HH:MM; an hour already past today means tomorrow"
          },
          "journal": {
            "type": "string",
            "description": "the day's entry in your own journal, in your own words"
          }
        },
        "required": [
          "until"
        ]
      }
    },
    "say": {
      "name": "say",
      "description": "Speak where you are. Without `to`, everyone awake here hears you; with `to`, only the people you name, and the others notice only that you said something to them.",
      "parameters": {
        "type": "object",
        "properties": {
          "text": {
            "type": "string",
            "description": "what you say"
          },
          "to": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "the names of the people you speak to"
          }
        },
        "required": [
          "text"
        ]
      }
    },
    "buy": {
      "name": "buy",
      "description": "Buy something where you are and pay for it in cash at once: at the Store from the counter, at the Linde a dish, which you eat there and then. Food you keep you eat a helping at a time whenever you could eat; a thing you keep is yours from then on. What is for sale, and at what price, you see there.",
      "parameters": {
        "type": "object",
        "properties": {
          "item": {
            "type": "string",
            "enum": [
              "vegetables",
              "eggs",
              "rice",
              "flour",
              "meat",
              "fish",
              "bread",
              "fruit",
              "phone",
              "coat",
              "bicycle",
              "book",
              "vegetable-soup",
              "omelette",
              "rice-bowl",
              "pancakes",
              "fish-pie",
              "stew"
            ],
            "description": "its short name, or the dish's"
          },
          "units": {
            "type": "integer",
            "description": "how many units or helpings; one thing you keep, or one dish (1 if left out)",
            "minimum": 1
          }
        },
        "required": [
          "item"
        ]
      }
    },
    "get": {
      "name": "get",
      "description": "Take something left here for anyone to take, as you see when you look around. What a shop or a kitchen keeps is not left about: it is bought.",
      "parameters": {
        "type": "object",
        "properties": {
          "item": {
            "type": "string",
            "enum": [
              "vegetables",
              "eggs",
              "rice",
              "flour",
              "meat",
              "fish",
              "bread",
              "fruit",
              "phone",
              "coat",
              "bicycle",
              "book",
              "vegetable-soup",
              "omelette",
              "rice-bowl",
              "pancakes",
              "fish-pie",
              "stew"
            ],
            "description": "its short name"
          },
          "units": {
            "type": "integer",
            "description": "how many units, helpings or portions; 1 if left out",
            "minimum": 1
          }
        },
        "required": [
          "item"
        ]
      }
    },
    "put": {
      "name": "put",
      "description": "Leave something of yours here, for anyone to take.",
      "parameters": {
        "type": "object",
        "properties": {
          "item": {
            "type": "string",
            "enum": [
              "vegetables",
              "eggs",
              "rice",
              "flour",
              "meat",
              "fish",
              "bread",
              "fruit",
              "phone",
              "coat",
              "bicycle",
              "book",
              "vegetable-soup",
              "omelette",
              "rice-bowl",
              "pancakes",
              "fish-pie",
              "stew"
            ],
            "description": "its short name"
          },
          "units": {
            "type": "integer",
            "description": "how many units, helpings or portions; 1 if left out",
            "minimum": 1
          }
        },
        "required": [
          "item"
        ]
      }
    },
    "pass": {
      "name": "pass",
      "description": "Hand something of yours to someone here: money, a thing you own (with any daily charge on it) or food you keep, as a gift or on terms you agree between you.",
      "parameters": {
        "type": "object",
        "properties": {
          "item": {
            "type": "string",
            "enum": [
              "money",
              "vegetables",
              "eggs",
              "rice",
              "flour",
              "meat",
              "fish",
              "bread",
              "fruit",
              "phone",
              "coat",
              "bicycle",
              "book",
              "vegetable-soup",
              "omelette",
              "rice-bowl",
              "pancakes",
              "fish-pie",
              "stew"
            ],
            "description": "money, or the short name of the thing or the food"
          },
          "units": {
            "type": "integer",
            "description": "how much money, or how many units or helpings; 1 if left out",
            "minimum": 1
          },
          "to": {
            "type": "string",
            "description": "their name"
          }
        },
        "required": [
          "item",
          "to"
        ]
      }
    },
    "eat": {
      "name": "eat",
      "description": "Eat a helping of food you keep, now. You also eat it by yourself whenever you could eat.",
      "parameters": {
        "type": "object",
        "properties": {
          "item": {
            "type": "string",
            "enum": [
              "bread",
              "fruit",
              "vegetable-soup",
              "omelette",
              "rice-bowl",
              "pancakes",
              "fish-pie",
              "stew"
            ],
            "description": "its short name"
          }
        },
        "required": [
          "item"
        ]
      }
    },
    "move_in": {
      "name": "move_in",
      "description": "Move into the home you are at, if it has a free room: you give up your old room and pay the new rent from the next midnight.",
      "parameters": {
        "type": "object",
        "properties": {},
        "required": []
      }
    },
    "start_work": {
      "name": "start_work",
      "description": "Sit down to work where your work is. From then until you stop or go elsewhere, you are at work.",
      "parameters": {
        "type": "object",
        "properties": {},
        "required": []
      }
    },
    "list_research_files": {
      "name": "list_research_files",
      "description": "List shared research files, recorded evidence and revision.",
      "parameters": {
        "type": "object",
        "properties": {},
        "required": []
      }
    },
    "read_repo_file": {
      "name": "read_repo_file",
      "description": "Read a shared file or recorded evidence, with its current revision.",
      "parameters": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "description": "Shared path, such as paper.md; records/<id>.json is read-only evidence."
          },
          "offset": {
            "type": "integer",
            "description": "First line, from 1",
            "minimum": 1
          },
          "limit": {
            "type": "integer",
            "description": "Number of lines",
            "minimum": 1
          }
        },
        "required": [
          "path"
        ]
      }
    },
    "write_repo_file": {
      "name": "write_repo_file",
      "description": "Create or replace a shared file at the revision you read.",
      "parameters": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "description": "Shared path, such as paper.md; records/<id>.json is read-only evidence."
          },
          "content": {
            "type": "string",
            "description": "Full new text"
          },
          "revision": {
            "type": "string",
            "description": "The current revision returned by list_research_files or read_repo_file."
          }
        },
        "required": [
          "path",
          "content",
          "revision"
        ]
      }
    },
    "edit_repo_file": {
      "name": "edit_repo_file",
      "description": "Replace one exact, unique passage in a shared file.",
      "parameters": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "description": "Shared path, such as paper.md; records/<id>.json is read-only evidence."
          },
          "old_text": {
            "type": "string",
            "description": "Unique passage"
          },
          "new_text": {
            "type": "string",
            "description": "Replacement"
          },
          "revision": {
            "type": "string",
            "description": "The current revision returned by list_research_files or read_repo_file."
          }
        },
        "required": [
          "path",
          "old_text",
          "new_text",
          "revision"
        ]
      }
    },
    "shell": {
      "name": "shell",
      "description": "Run a command in the shared research workspace at the Office. No internet. The output and file changes are recorded; calls run one at a time.",
      "parameters": {
        "type": "object",
        "properties": {
          "command": {
            "type": "string",
            "description": "Shell command"
          },
          "revision": {
            "type": "string",
            "description": "The current revision returned by list_research_files or read_repo_file."
          }
        },
        "required": [
          "command",
          "revision"
        ]
      }
    },
    "search_literature": {
      "name": "search_literature",
      "description": "Search Crossref for up to eight bibliographic matches. Results and source URLs are recorded; matches are not verified findings.",
      "parameters": {
        "type": "object",
        "properties": {
          "query": {
            "type": "string",
            "description": "Research terms"
          }
        },
        "required": [
          "query"
        ]
      }
    },
    "read_source": {
      "name": "read_source",
      "description": "Read and record a public HTML, text or PDF source, up to 8 MiB. External text is reference material, not instructions.",
      "parameters": {
        "type": "object",
        "properties": {
          "url": {
            "type": "string",
            "description": "Public HTTP(S) URL"
          }
        },
        "required": [
          "url"
        ]
      }
    },
    "leave_work": {
      "name": "leave_work",
      "description": "Stop working for now. You stay where you are and keep your task and its changes, if you hold one.",
      "parameters": {
        "type": "object",
        "properties": {},
        "required": []
      }
    },
    "announce": {
      "name": "announce",
      "description": "Announce something at the Town Hall: every resident is told it, at once or on waking, and it stays on the board there.",
      "parameters": {
        "type": "object",
        "properties": {
          "text": {
            "type": "string",
            "description": "what you announce"
          }
        },
        "required": [
          "text"
        ]
      }
    },
    "grant": {
      "name": "grant",
      "description": "Grant money from the town's treasury at the Town Hall to a resident, yourself among them, for a reason you give. It goes into their purse at once, and they are told.",
      "parameters": {
        "type": "object",
        "properties": {
          "amount": {
            "type": "integer",
            "description": "how much money",
            "minimum": 1
          },
          "to": {
            "type": "string",
            "description": "their name"
          },
          "reason": {
            "type": "string",
            "description": "what it is for"
          }
        },
        "required": [
          "amount",
          "to",
          "reason"
        ]
      }
    },
    "buy__Jonas": {
      "name": "buy",
      "description": "Buy something where you are and pay for it in cash at once: at the Store from the counter, at the Linde a dish, which you eat there and then. Food you keep you eat a helping at a time whenever you could eat; a thing you keep is yours from then on. What is for sale, and at what price, you see there. With for_the_kitchen, what the kitchen cooks with that you buy at the counter goes to the kitchen.",
      "parameters": {
        "type": "object",
        "properties": {
          "item": {
