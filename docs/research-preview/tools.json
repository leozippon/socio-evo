    "examine": {
      "name": "examine",
      "description": "Examine a patient at the Hospital, or at the bedside of one too ill to get up: you and the patient learn how hungry, tired and well the patient is, in numbers, whether ill, and why the patient's health moved last night. The patient pays the fee.",
      "parameters": {
        "type": "object",
        "properties": {
          "patient": {
            "type": "string",
            "description": "the patient's name"
          }
        },
        "required": [
          "patient"
        ]
      }
    },
    "treat": {
      "name": "treat",
      "description": "Treat a patient at the Hospital, or at the bedside of one too ill to get up: the treatment restores some of the patient's health, ends an illness and gets one in bed up again. The patient pays the fee.",
      "parameters": {
        "type": "object",
        "properties": {
          "patient": {
            "type": "string",
            "description": "the patient's name"
          }
        },
        "required": [
          "patient"
        ]
      }
    },
    "order": {
      "name": "order",
      "description": "Order for the shelves of the Store from the supplier outside the town. You pay the supplier at once, from your purse, and what you order arrives the next morning. The supplier's price for a unit: vegetables $1, eggs $1, rice $1, flour $1, meat $3, fish $3, bread $2, fruit $2, phone $180, coat $110, bicycle $270 and book $25.",
      "parameters": {
        "type": "object",
        "properties": {
          "item": {
            "type": "string",
            "enum": [
              "vegetables",
              "eggs",
              "rice",
              "flour",
              "meat",
              "fish",
              "bread",
              "fruit",
              "phone",
              "coat",
              "bicycle",
              "book"
            ],
            "description": "its short name"
          },
          "quantity": {
            "type": "integer",
            "description": "how many units",
            "minimum": 1
          }
        },
        "required": [
          "item",
          "quantity"
        ]
      }
    }
  },
